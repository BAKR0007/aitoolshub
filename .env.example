# =====================================================================
# AIToolsHub — Environment Variables
# Copy this file to `.env` and fill in real values
# =====================================================================

# Database — for production use PostgreSQL or MySQL instead of SQLite
# Example (Neon PostgreSQL free tier):
# DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/aitoolshub?sslmode=require
DATABASE_URL=file:./db/custom.db

# NextAuth (when you wire up authentication)
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# NEXTAUTH_URL=https://bakrr.net/AIToolsHub

# Stripe (when you wire up payments)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# PayPal
# PAYPAL_CLIENT_ID=xxx
# PAYPAL_CLIENT_SECRET=xxx

# Redis (for caching & queues in production)
# REDIS_URL=redis://localhost:6379

# App config
NEXT_PUBLIC_APP_NAME=AIToolsHub
NEXT_PUBLIC_APP_URL=https://bakrr.net/AIToolsHub
